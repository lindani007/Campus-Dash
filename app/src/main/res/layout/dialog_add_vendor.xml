<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add New Vendor &amp; Store"
        android:textColor="#FF9800"
        android:textSize="20sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_vendor_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Vendor Full Name"
        android:inputType="textPersonName" />

    <EditText
        android:id="@+id/et_vendor_email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Vendor Email"
        android:inputType="textEmailAddress" />

    <EditText
        android:id="@+id/et_store_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Store Name"
        android:inputType="text" />

    <EditText
        android:id="@+id/et_vendor_phone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Phone Number"
        android:inputType="phone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="* Default password will be created as [StoreName]@123"
        android:textColor="#777777"
        android:textSize="12sp" />

</LinearLayout>