<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="#FFFFFF"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_payment_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Payment #P1001"
        android:textColor="#FF9800"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_student_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Student: Thabo Mokoena"
        android:textColor="#444444"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tv_vendor_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Vendor: Campus Cafe"
        android:textColor="#444444"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tv_payment_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Amount: R65.00"
        android:textColor="#444444"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tv_payment_method"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Method: Card"
        android:textColor="#444444"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tv_payment_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Status: Successful"
        android:textColor="#FF9800"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>